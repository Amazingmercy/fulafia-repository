# .env.example — FULafia Institutional Repository
# Copy to .env and fill in real values before starting

# ────────────────────────────────────────────────────────────
# DATABASE
# ────────────────────────────────────────────────────────────
DATABASE_URL=

# ────────────────────────────────────────────────────────────
# JWT / AUTH
# ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ────────────────────────────────────────────────────────────
# STORAGE PROVIDER
# Options: LOCAL | S3 | CLOUDINARY
# ────────────────────────────────────────────────────────────
STORAGE_PROVIDER="LOCAL"

# AWS S3 (only required when STORAGE_PROVIDER=S3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# Cloudinary (only required when STORAGE_PROVIDER=CLOUDINARY)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ────────────────────────────────────────────────────────────
# TURNITIN SIMILARITY API (Layer 1 external plagiarism check)
# Leave blank to use the built-in simulator in dev
# ────────────────────────────────────────────────────────────
TURNITIN_API_KEY=""
TURNITIN_API_URL=""

# ────────────────────────────────────────────────────────────
# CORS
# Comma-separated list of allowed origins
# ────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=

# ────────────────────────────────────────────────────────────
# SERVER
# ────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"

# ────────────────────────────────────────────────────────────
# PLAGIARISM THRESHOLDS
# Submissions above either threshold are held for manual review
# ────────────────────────────────────────────────────────────
EXTERNAL_SIMILARITY_THRESHOLD=20
INTERNAL_SIMILARITY_THRESHOLD=15
